<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.comunidad_programadores.InicioController">
   <children>
      <Label fx:id="labelBienvenida" layoutX="240.0" layoutY="38.0" prefHeight="24.0" prefWidth="120.0" text="¡Bienvenido, " />
      <Button layoutX="450.0" layoutY="37.0" mnemonicParsing="false" onAction="#cerrarSesion" text="Cerrar sesión" />
      <Label layoutX="139.0" layoutY="93.0" text="Filtrar por lenguaje: " />
      <ComboBox fx:id="cbLenguaje" layoutX="262.0" layoutY="89.0" onAction="#seleccionarLenguaje" prefWidth="150.0" promptText="Todos" />
      <TableView fx:id="tvProgramadores" layoutX="136.0" layoutY="136.0" prefHeight="167.0" prefWidth="327.0">
        <columns>
          <TableColumn fx:id="colUsuario" prefWidth="96.33331298828125" text="Usuario" />
          <TableColumn fx:id="colGenero" prefWidth="119.66668701171875" text="Género" />
            <TableColumn fx:id="colLenguaje" prefWidth="110.33331298828125" text="Lenguaje" />
        </columns>
      </TableView>
      <Button layoutX="166.0" layoutY="326.0" mnemonicParsing="false" onAction="#editarPerfil" text="Editar perfil" />
      <Button layoutX="285.0" layoutY="326.0" mnemonicParsing="false" onAction="#crearExcel" text="Excel" />
      <Button layoutX="377.0" layoutY="326.0" mnemonicParsing="false" onAction="#crearPdf" text="PDF" />
   </children>
</AnchorPane>
