<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.comunidad_programadores.EditarController">
   <children>
      <Label layoutX="77.0" layoutY="61.0" prefHeight="17.0" prefWidth="74.0" text="Editar perfil" />
      <Label layoutX="77.0" layoutY="113.0" text="Nombre de usuario: " />
      <Label layoutX="77.0" layoutY="151.0" text="Contraseña: " />
      <Label layoutX="77.0" layoutY="200.0" text="Género: " />
      <Label layoutX="80.0" layoutY="249.0" text="Lenguaje de programación" />
      <TextField fx:id="txtNombre" layoutX="249.0" layoutY="109.0" />
      <TextField fx:id="txtContrasena" layoutX="249.0" layoutY="147.0" />
      <RadioButton layoutX="249.0" layoutY="200.0" mnemonicParsing="false" text="Hombre ">
         <toggleGroup>
            <ToggleGroup fx:id="genero" />
         </toggleGroup></RadioButton>
      <RadioButton layoutX="324.0" layoutY="200.0" mnemonicParsing="false" text="Mujer" toggleGroup="$genero" />
      <RadioButton layoutX="384.0" layoutY="200.0" mnemonicParsing="false" text="Prefiero no decirlo" toggleGroup="$genero" />
      <ComboBox fx:id="cbLenguaje" layoutX="251.0" layoutY="245.0" prefWidth="150.0" />
      <Button layoutX="211.0" layoutY="314.0" mnemonicParsing="false" onAction="#guardar" text="Guardar cambios" />
      <Button layoutX="351.0" layoutY="314.0" mnemonicParsing="false" onAction="#cancelar" text="Cancelar" />
   </children>
</AnchorPane>
